# ======================================================================
# MICROCOSM — .gitignore (Hygiene Audit)
# ======================================================================

# Node & Package Managers
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js / Frontend Build Outputs
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/

# Foundry / Solidity Compilation & Broadcasts
cache/
**/cache/
broadcast/
**/broadcast/
contracts/out/
contracts/cache/
contracts/broadcast/

# Logs & Test Runtime Artifacts
*.log
anvil*.log
*.anvil.log
anvil-*.log
coverage/
.nyc_output/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example

# Editor & OS Artifacts
*.swp
*~
.DS_Store
Thumbs.db

# Microcosm State Snapshots & Lockfiles
microcosm-data.json
microcosm-data.json.*
/tmp/microcosm-*

# HyperFrames working snapshots (regenerate with: npx hyperframes snapshot)
videos/*/snapshots*/
videos/*/dist/

# Demo Foundry local toolchain venv and render workspace
.demo-foundry/
apps/*/test-results/
apps/*/tsconfig.tsbuildinfo
apps/charcoal/.next-e2e/
