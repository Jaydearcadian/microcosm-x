# OKX X Layer Testnet (chain 1952; mainnet is 196)
XLAYER_RPC_URL=https://testrpc.xlayer.tech
XLAYER_CHAIN_ID=1952

# Deployer Key (funded with testnet OKB from https://www.okx.com/xlayer/faucet)
PRIVATE_KEY=0x...

# Optional: existing testnet USDC address (leave empty to deploy MockUSDC)
USDC_ADDRESS=

# Optional: Space authority owning the contracts (defaults to the broadcaster)
DEPLOYER_ADDRESS=

# OKLink Explorer API Key (for contract source verification)
OKLINK_API_KEY=your_oklink_api_key_here
